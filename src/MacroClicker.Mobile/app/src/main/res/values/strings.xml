    <!-- 录制 -->
    <string name="record_desc">在淡色标记层上像平时一样操作手机：点击、长按、滑动与操作间隔会被自动识别成动作序列（与桌面端体验一致）。开启「回放同步」后，每个动作会立即真实作用于当前界面，支持「点按钮 → 等弹窗 → 再点」的多步流程。</string>
    <string name="record_live_replay">回放同步（边录边执行，推荐）</string>
