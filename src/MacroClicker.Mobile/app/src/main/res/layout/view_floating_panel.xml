<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_panel"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingBottom="14dp"
    android:paddingTop="10dp">

    <!-- 标题栏：可拖动 -->
    <LinearLayout
        android:id="@+id/panelDragBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/panel_title"
            android:textColor="#1B1E27"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCollapse"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="—"
            android:textColor="#6B7280"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/panel_status_idle"
        android:textColor="#16A34A"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPlay"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_btn_primary"
            android:gravity="center"
            android:text="@string/panel_play"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_btn_danger"
            android:gravity="center"
            android:text="@string/panel_stop"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnAddTap"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_btn_neutral"
            android:gravity="center"
            android:text="@string/panel_add_tap"
            android:textColor="#1B1E27"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnAddSwipe"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_btn_neutral"
            android:gravity="center"
            android:text="@string/panel_add_swipe"
            android:textColor="#1B1E27"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnOpenList"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_btn_neutral"
            android:gravity="center"
            android:text="@string/panel_list"
            android:textColor="#1B1E27"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnCollapse2"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_btn_neutral"
            android:gravity="center"
            android:text="@string/panel_collapse"
            android:textColor="#1B1E27"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
